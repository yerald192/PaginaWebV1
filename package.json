{
  "name": "paginawebv1",
  "version": "1.0.0",
  "description": "Portal Institucional IESTP Huanta con Tailwind CSS",
  "main": "index.html",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./css/tailwind.css --watch",
    "serve": "live-server --port=3000 --no-browser",
    "dev": "concurrently \"npm run watch:css\" \"npm run serve\"",
    "build": "npm run build:css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yerald192/PaginaWebV1.git"
  },
  "keywords": [
    "iestp",
    "tailwindcss"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "live-server": "^1.2.2",
    "postcss": "^8.5.31",
    "postcss-import": "^16.1.0",
    "tailwindcss": "^3.4.19"
  }
}